; Engine configuration file.
; Input actions are registered in code (scripts/core/controls.gd) so they stay in one readable place.

config_version=5

[application]

config/name="Best Fwend"
config/description="A physics buddy sandbox."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.08, 0.07, 0.1, 1)
boot_splash/show_image=false

[autoload]

Events="*res://scripts/core/events.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/audio/sfx.gd"
Music="*res://scripts/audio/music.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input_devices]

pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
2d/default_gravity=1960.0
2d/solver/solver_iterations=24

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)
